# Generated training data and output
data/

# Vendor-specific API configs (local only — not part of the generic framework).
# Note: apis/* (not apis/) so the negations below can re-include specific vendors;
# git cannot re-include paths under a wholly-excluded directory.
apis/*
# ...except the example vendor, which is a template showing what to create
!apis/example/
!apis/example/**
# ...except videoamp, which is the reference implementation (scripts committed)
!apis/videoamp/
!apis/videoamp/**

# Specific code-path repo configs (local only — not part of the generic framework).
# Same convention as apis/* above: repos/* so the negation can re-include the
# example; only the generic example demonstrator is tracked.
repos/*
# ...except the example, which is the template pointing at the in-tree fixture.
!repos/example/
!repos/example/**
handoff/
.fastembed_cache/
.hermes/
HANDOFF.md
# Local phase-execution trackers (resumable state, not part of the codebase)
PHASE*_PROGRESS.md


# Scratch / temporary files
tmp/

# Python
__pycache__/
*.pyc
*.pyo
.env
.venv/
.pytest_cache/

# Log files
*.log.jsonl

# Local notes
issues.md

# devtribunal (remove these lines to version-control agents and skills)
.devtribunal_agents/
.claude/commands/dt/
